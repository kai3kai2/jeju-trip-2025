# Line Messaging API 設定
# 文檔：https://developers.line.biz/en/services/messaging-api/

# 1. Channel Access Token
# 在 LINE Developers 控制台 → Messaging API 設定
# → Channel Access Token → 點擊「Issue」生成
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# 2. Channel Secret
# 在 LINE Developers 控制台直接可見
LINE_CHANNEL_SECRET=your_channel_secret_here

# 3. Webhook URL
# 本地測試: https://your-ngrok-url.ngrok.io/api/line/webhook
# 生產環境: https://your-domain.com/api/line/webhook
WEBHOOK_URL=https://your-domain.com/api/line/webhook

# 伺服器設定
PORT=3001
